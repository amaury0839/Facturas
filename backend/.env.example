# Token del bot de Telegram que procesa los webhooks
FACTURAS_TELEGRAM_BOT_TOKEN=pon_aqui_tu_token_bot

# Secreto opcional para validar el query param "token" en /telegram/webhook
FACTURAS_TELEGRAM_WEBHOOK_SECRET=webhook-secret

# Notificaciones opcionales (por ejemplo, al crear una factura)
TELEGRAM_BOT_TOKEN=notificador-opcional
TELEGRAM_CHAT_ID=12345678
